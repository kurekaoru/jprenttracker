# Global fallback Slack webhook (used if no users have registered)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Telegram bot (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Google Maps server-side key (restrict by IP, not HTTP referrer)
# Enable: Directions API only. Used by /api/route to proxy transit directions.
GOOGLE_MAPS_SERVER_KEY=YOUR_SERVER_SIDE_GOOGLE_MAPS_KEY

# Slack OAuth app (https://api.slack.com/apps → Create App → Incoming Webhooks)
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_REDIRECT_URI=https://jkk-monitor.duckdns.org/api/auth/slack/callback

# Dashboard URL (for QR code share)
DASHBOARD_URL=https://kurekaoru.github.io/jprenttracker/dashboard.html

# SMTP for email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
