# Global fallback Slack webhook (used if no users have registered)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack OAuth app (https://api.slack.com/apps → Create App → Incoming Webhooks)
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_REDIRECT_URI=https://jkk-monitor.duckdns.org/api/auth/slack/callback

# Dashboard URL (for QR code share)
DASHBOARD_URL=https://kurekaoru.github.io/jprenttracker/dashboard.html

# SMTP for email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
